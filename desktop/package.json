{
  "name": "platfight-studio",
  "productName": "PlatFight Studio",
  "version": "1.2.0",
  "description": "Créateur de jeux de combat façon Smash, compatible persos Mugen / JUS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "exe": "electron-builder --win portable --x64",
    "installeur": "electron-builder --win nsis --x64",
    "exe:dossier": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.platfight.studio",
    "productName": "PlatFight Studio",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "directories": {
      "output": "sortie"
    },
    "win": {
      "target": "portable",
      "artifactName": "PlatFight-Studio-${version}.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}